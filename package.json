{
  "name": "@waishnav/devspace",
  "version": "1.1.1-windows.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrfgup/taskquay.git"
  },
  "homepage": "https://github.com/wrfgup/taskquay#readme",
  "bugs": {
    "url": "https://github.com/wrfgup/taskquay/issues"
  },
  "description": "Taskquay for Windows 10/11 x64; external agent CLIs via MCP stdio.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "devspace": "bin/devspace.js",
    "devspace-agentd": "bin/devspace-agentd.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "schema",
    "scripts/install-windows.ps1",
    "scripts/uninstall-windows.ps1",
    "build-info.json",
    "README.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && pnpm build:app && tsc -p tsconfig.build.json && node scripts/specialize-windows.mjs",
    "build:app": "vite build",
    "dev": "tsx scripts/dev.ts",
    "dev:seed": "tsx scripts/dev-state.ts seed",
    "dev:reset": "tsx scripts/dev-state.ts reset",
    "prepack": "pnpm build",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "start": "node dist/cli.js serve",
    "test": "tsx scripts/test-with-receipt.ts",
    "test:package-install": "tsx --test --test-concurrency=1 \"test/package-install-smoke.test.ts\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "package:windows": "node scripts/package-windows.mjs",
    "test:windows": "node scripts/acceptance-windows.mjs",
    "test:windows:regression": "node --import tsx --test --test-concurrency=1 src/process-platform.test.ts src/static-token-store.test.ts src/static-token-auth.test.ts src/cli-auth-token.test.ts src/local-agent-claude-cli.test.ts src/local-agent-availability.test.ts src/local-agent-managed-turn.test.ts src/execution-runner.test.ts && node --import tsx --test --test-name-pattern=\"tool modes expose\" src/server.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@pierre/diffs": "^1.3.6",
    "better-result": "^2.10.0",
    "better-sqlite3": "^12.10.0",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.1.2",
    "lucide": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "unpdf": "~1.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "esbuild": "^0.27.0"
  },
  "overrides": {
    "protobufjs": "7.6.4",
    "ws": "8.21.0",
    "undici": "8.5.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ]
}
